# Copia este archivo como referencia y define las variables en tu entorno.
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=bingo_db_prod
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
# Nunca actives debug en un servidor accesible desde la red: el debugger de Werkzeug permite ejecutar código.
FLASK_DEBUG=false
# "*" o lista separada por comas, p. ej. http://localhost:3000,http://192.168.1.10:3000
CORS_ORIGINS=*
# Carpetas de trabajo (por defecto dentro del proyecto)
# BINGO_JSON_DIR=./jsons
# BINGO_WINNERS_DIR=./winners
# BINGO_UPLOAD_DIR=./upload
# Snapshots bingo_cards_active_*.json que se conservan al reiniciar la partida
BINGO_ACTIVE_JSON_KEEP=10
BINGO_CREATE_INDEXES=true
# Tamaño máximo de una petición (PDF de /upload), en MB
BINGO_MAX_UPLOAD_MB=50
# Hilos del servidor waitress (solo cuando FLASK_DEBUG=false)
BINGO_THREADS=8

# --- Inicio de sesión con Google (OAuth 2.0) ---
# ID de cliente OAuth (tipo "Aplicación web") de Google Cloud Console.
GOOGLE_CLIENT_ID=579049993014-2kgtu0631odv746rvkav01ivglcgihh7.apps.googleusercontent.com
# Clave larga y aleatoria para firmar las sesiones. Genérala con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BINGO_SECRET_KEY=
BINGO_SESSION_HOURS=8
# Correos con rol administrador y el usuario de la colección Users que representan.
BINGO_ADMIN_EMAILS=admin@uets.edu.ec
BINGO_ADMIN_USUARIO=ADMIN
BINGO_STAFF_DOMAIN=uets.edu.ec
# Dominio ADICIONAL para estudiantes (los de 2026 usan @uets.edu.ec, que siempre se acepta).
BINGO_STUDENT_DOMAIN=est.uets.edu.ec

# --- Correo saliente: tablas al comprador después de cada venta ---
# Cuenta noreply@uets.edu.ec (Google Workspace) con contraseña de aplicación.
# La contraseña va SOLO en el .env del servidor, nunca en el repositorio.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noreply@uets.edu.ec
SMTP_PASS=
MAIL_FROM=Sistema UETS <noreply@uets.edu.ec>
# Dirección del panel que se indica en el correo para ver las tablas.
PANEL_URL=https://consultas.uets.edu.ec
